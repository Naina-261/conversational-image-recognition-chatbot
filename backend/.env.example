# Backend Environment Variables
APP_NAME="BEL Conversational Image Recognition Backend"
ENVIRONMENT=production
DEBUG=false
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1

# CORS Configuration (Comma-separated origins or *)
CORS_ORIGINS=https://*.vercel.app,http://localhost:5173,http://localhost:3000

# Database Configuration
# PostgreSQL:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bel_chatbot_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bel_chatbot_db
# SQLite (Local Development / Testing fallback):
# DATABASE_URL=sqlite+aiosqlite:///./bel_chatbot.db
# SYNC_DATABASE_URL=sqlite:///./bel_chatbot.db

# Storage Paths & Limits
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=15

# Deep Learning Inference Configuration
DEVICE_OVERRIDE=cpu
YOLO_MODEL_NAME=yolov8n.pt
VQA_MODEL_NAME=Salesforce/blip-vqa-base
CONFIDENCE_THRESHOLD=0.35

# External VQA Credentials
# Google Gemini API key (Free tier at https://aistudio.google.com/ - preferred)
GEMINI_API_KEY=
# Hugging Face Serverless API Token (Fallback at https://huggingface.co/settings/tokens)
HF_TOKEN=
